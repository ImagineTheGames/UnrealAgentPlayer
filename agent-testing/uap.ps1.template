# uap.ps1 -- run the UnrealAgentPlayer test CLI via its venv, from anywhere.
# Generated by Install-AgentTest.ps1. Usage: powershell -NoProfile -File uap.ps1 <verb> [args...]
param([Parameter(ValueFromRemainingArguments = $true)] $Args)
$ErrorActionPreference = 'Stop'

# Prefer an explicit UAP_HOME (the unreal-agent-player repo root) if set; otherwise
# use the python path baked in at install time.
if ($env:UAP_HOME -and (Test-Path "$env:UAP_HOME/mcp-server/.venv/Scripts/python.exe")) {
    $py = "$env:UAP_HOME/mcp-server/.venv/Scripts/python.exe"
} else {
    $py = "__UAP_PYTHON__"
}

if (-not (Test-Path $py)) {
    Write-Error "uap: python venv not found at '$py'. Re-run Install-AgentTest.ps1, or build the venv (cd mcp-server; python -m venv .venv; .venv\Scripts\pip install -e '.[dev]'), or set `$env:UAP_HOME to the unreal-agent-player repo root."
    exit 3
}

# Pin this project's editor as the default target so commands run from THIS launcher never
# cross-target another open editor (e.g. `uap pie start` with no --project). Caller env wins.
if (-not $env:UAP_PROJECT)  { $env:UAP_PROJECT  = "__UAP_PROJECT__" }
if (-not $env:UAP_UPROJECT) { $env:UAP_UPROJECT = "__UAP_UPROJECT__" }
# This project's engine editor exe (resolved from its .uproject EngineAssociation at install
# time) -- different projects can use different engines (e.g. a custom fork vs stock UE). Only
# set when resolved; else game_launch falls back to its own default.
if ((-not $env:UAP_EDITOR_EXE) -and "__UAP_EDITOR_EXE__") { $env:UAP_EDITOR_EXE = "__UAP_EDITOR_EXE__" }

& $py -m unreal_agent_player.cli @Args
exit $LASTEXITCODE
