# uap.ps1 -- run the UnrealAgentPlayer CLI against THIS project's editor.
#
# Generated by Install-AgentTest.ps1. Usage:
#   powershell -NoProfile -File uap.ps1 <verb> [args...]
#   powershell -NoProfile -File uap.ps1 help
#
# COMMIT THIS FILE to your project's source control. It contains no machine-local paths --
# everything is derived at run time, so the same file works for every teammate:
#   * project root / .uproject -> this script's own location
#   * engine editor exe        -> .uproject EngineAssociation -> registry (source build,
#                                 launcher install, or an explicit path all work)
#   * UnrealAgentPlayer repo   -> $env:UAP_HOME, a path relative to the project, or a sibling
#
# Per-machine setup each teammate does once:
#   git clone https://github.com/ImagineTheGames/UnrealAgentPlayer.git
#   cd UnrealAgentPlayer\mcp-server
#   python -m venv .venv
#   .venv\Scripts\pip install -e ".[dev]"
# If the clone is not beside the project, set UAP_HOME:
#   [Environment]::SetEnvironmentVariable('UAP_HOME','D:\dev\UnrealAgentPlayer','User')

param([Parameter(ValueFromRemainingArguments = $true)] $UapArgs)
$ErrorActionPreference = 'Stop'

$projectRoot = $PSScriptRoot

# --- Resolve this project's engine editor exe ------------------------------------------
# Different projects use different engines (a custom fork vs stock UE), and teammates keep
# them in different places, so this is resolved per machine rather than baked in.
# Resolution order mirrors Epic's own, from FDesktopPlatformWindows::EnumerateEngineInstallations:
#   1. UE_ROOT               -- escape hatch for layouts nothing else knows about
#   2. LauncherInstalled.dat -- every Epic Games Launcher install, any drive
#   3. HKCU ...\Builds       -- source and per-user builds, GUID keyed
# HKLM\SOFTWARE\EpicGames\Unreal Engine\<ver>\InstalledDirectory is deliberately NOT consulted.
# The engine never reads it, newer launchers no longer write it, and a key left behind by an
# uninstall points at nothing -- resolving by a rule the engine does not share is how a script
# and the editor end up disagreeing about which engine is "the" engine.
function Resolve-EditorExe([string] $Root) {
    $engineRoot = ''

    if ($env:UE_ROOT -and (Test-Path (Join-Path $env:UE_ROOT 'Engine\Build\BatchFiles'))) {
        $engineRoot = $env:UE_ROOT
    }

    $uproj = Get-ChildItem -LiteralPath $Root -Filter '*.uproject' -File -ErrorAction SilentlyContinue |
             Select-Object -First 1
    if (-not $uproj) { return '' }
    try { $assoc = (Get-Content -LiteralPath $uproj.FullName -Raw | ConvertFrom-Json).EngineAssociation }
    catch { return '' }
    if (-not $assoc) { return '' }

    if (-not $engineRoot -and $assoc -match '^[0-9]+\.[0-9]+$') {
        # Engine rows are the ones whose AppName is "UE_<assoc>". Sibling rows
        # (QuixelBridge_5.7, FabPlugin_5.7) share an InstallLocation, so key off AppName.
        $manifest = Join-Path $env:ProgramData 'Epic\UnrealEngineLauncher\LauncherInstalled.dat'
        if (Test-Path $manifest) {
            try {
                $entry = (Get-Content -LiteralPath $manifest -Raw | ConvertFrom-Json).InstallationList |
                         Where-Object { $_.AppName -ceq "UE_$assoc" } | Select-Object -First 1
                if ($entry) { $engineRoot = $entry.InstallLocation }
            } catch { }
        }
    }

    if (-not $engineRoot -and $assoc -match '^\{?[0-9A-Fa-f-]{36}\}?$') {
        try {
            $builds = Get-ItemProperty 'HKCU:\SOFTWARE\Epic Games\Unreal Engine\Builds' -ErrorAction Stop
            foreach ($p in $builds.PSObject.Properties) {
                if ($p.Name -match '^PS') { continue }
                if ($p.Name.Trim('{','}') -ine $assoc.Trim('{','}')) { continue }
                $engineRoot = $p.Value; break
            }
        } catch { }
    }

    if (-not $engineRoot -and (Test-Path $assoc)) {
        $engineRoot = $assoc                                     # absolute path association
    }
    if (-not $engineRoot) {
        $candidate = Join-Path $Root $assoc                      # relative to the project
        if (Test-Path $candidate) { $engineRoot = (Resolve-Path $candidate).Path }
    }

    if (-not $engineRoot) { return '' }
    $exe = Join-Path $engineRoot 'Engine\Binaries\Win64\UnrealEditor.exe'
    if (Test-Path $exe) { return $exe } else { return '' }
}

# --- Locate the UnrealAgentPlayer repo -------------------------------------------------
$searched = @()
$uapHome  = $null

function Test-UapHome([string] $Path) {
    if (-not $Path) { return $false }
    return (Test-Path (Join-Path $Path 'mcp-server\pyproject.toml'))
}

if ($env:UAP_HOME) {
    $searched += "`$env:UAP_HOME = $env:UAP_HOME"
    if (Test-UapHome $env:UAP_HOME) { $uapHome = $env:UAP_HOME }
}

if (-not $uapHome -and '__UAP_HOME_RELATIVE__') {
    # Path from the project root to the repo, recorded at install time. Relative, so it
    # survives the whole tree moving to another drive.
    $rel = Join-Path $projectRoot '__UAP_HOME_RELATIVE__'
    $searched += $rel
    if (Test-UapHome $rel) { $uapHome = (Resolve-Path $rel).Path }
}

if (-not $uapHome) {
    $parent = Split-Path -Parent $projectRoot
    foreach ($name in 'unreal-agent-player', 'UnrealAgentPlayer') {
        $candidate = Join-Path $parent $name
        $searched += $candidate
        if (Test-UapHome $candidate) { $uapHome = $candidate; break }
    }
}

if (-not $uapHome) {
    Write-Error @"
uap: could not find the UnrealAgentPlayer repo.

Searched:
$($searched | ForEach-Object { "  $_" } | Out-String)
This is a ONE-TIME per-machine setup step, not a bug in the project:

  git clone https://github.com/ImagineTheGames/UnrealAgentPlayer.git
  cd UnrealAgentPlayer\mcp-server
  python -m venv .venv
  .venv\Scripts\pip install -e ".[dev]"

Clone it beside the project, or point UAP_HOME at it:
  [Environment]::SetEnvironmentVariable('UAP_HOME','D:\path\to\UnrealAgentPlayer','User')
"@
    exit 3
}

# --- Locate its venv python ------------------------------------------------------------
$py = Join-Path $uapHome 'mcp-server\.venv\Scripts\python.exe'
if (-not (Test-Path $py)) {
    Write-Error @"
uap: python venv not found at '$py'.

Build it once (Python 3.11+):
  cd "$uapHome\mcp-server"
  python -m venv .venv
  .venv\Scripts\pip install -e ".[dev]"
"@
    exit 3
}

# --- Pin THIS project's editor as the default target -----------------------------------
# Several editors can be open at once. Without these, a bare `uap pie start` targets
# "the first editor that answers" -- which can be the wrong project. Caller env wins.
if (-not $env:UAP_PROJECT)  { $env:UAP_PROJECT  = '__UAP_PROJECT__' }
if (-not $env:UAP_UPROJECT) {
    $uproj = Get-ChildItem -LiteralPath $projectRoot -Filter '*.uproject' -File -ErrorAction SilentlyContinue |
             Select-Object -First 1
    if ($uproj) { $env:UAP_UPROJECT = $uproj.FullName }
}
if (-not $env:UAP_EDITOR_EXE) {
    # Best effort: only `game_launch` needs it, and `uap status` reports the real problem
    # better than failing here would.
    $exe = Resolve-EditorExe $projectRoot
    if ($exe) { $env:UAP_EDITOR_EXE = $exe }
}

& $py -m unreal_agent_player.cli @UapArgs
exit $LASTEXITCODE
